(defun num_posicion (lista pos)
  (append
   (list (car (append
               (butlast lista (- (length lista) pos))
               (cdr (nthcdr pos lista)))))
   (list (cadr (append
		(butlast lista (- (length lista) pos))
		(cdr (nthcdr pos lista)))))
   (append (list (nth pos lista)) (nthcdr 2 (append
					     (butlast lista (- (length lista) pos))
					     (cdr (nthcdr pos lista)))))))

